# Copy this file to .env.local and fill in real values.
# .env.local is gitignored; nothing here is a secret worth protecting on its
# own (these are the public/anon-role keys), but a real value doesn't belong
# checked into source either.

# Supabase project (Settings -> API in the Supabase dashboard).
# Enables Google sign-in on the Profile screen; the game runs fine without
# these set, it just shows sign-in as unavailable.
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=

# A REST backend for the leaderboard/level-sharing services in src/online/.
# Unset by default: those features are built and testable against a clear
# "not configured" error, not a live server.
VITE_API_BASE_URL=
